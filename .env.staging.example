# ==============================================================================
# JanaSahayak - Staging Environment Configuration Template
# ==============================================================================

NODE_ENV=staging

# PostgreSQL Database Configuration
POSTGRES_DB=janasahayak_staging
POSTGRES_USER=janasahayak_staging_user
POSTGRES_PASSWORD=staging_secure_password_replace_in_vault
POSTGRES_PORT=5433
DATABASE_URL=postgresql://janasahayak_staging_user:staging_secure_password_replace_in_vault@127.0.0.1:5433/janasahayak_staging
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
SESSION_SECRET=staging_session_secret_min_32_characters_random_string_here

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# AI & Language Services (Mock for deterministic staging tests)
AI_PROVIDER=mock
BHASHINI_API_KEY=mock-staging-key
BHASHINI_USER_ID=mock-staging-user
