# ==============================================================================
# JanaSahayak — Example Environment Configuration
# Copy to .env for local development. NEVER commit .env or real secrets.
# ==============================================================================

# Runtime Environment: development | test | staging | production
NODE_ENV=development

# API Service
API_HOST=127.0.0.1
API_PORT=4000
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY=false

# PostgreSQL Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=janasahayak_dev
POSTGRES_USER=janasahayak
POSTGRES_PASSWORD=change_me_local_dev_only
DATABASE_URL=postgresql://janasahayak:change_me_local_dev_only@127.0.0.1:5432/janasahayak_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Web Application (Next.js)
NEXT_PUBLIC_APP_NAME=JanaSahayak
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# AI Provider (Phase 10 — kept mock by default in local dev)
AI_PROVIDER=mock
