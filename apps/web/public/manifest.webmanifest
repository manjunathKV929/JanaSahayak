{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "JanaSahayak — Government Services Explained",
  "short_name": "JanaSahayak",
  "description": "Multilingual, accessibility-first public-service guidance platform helping citizens navigate government schemes, eligibility, and official documents.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#F7F6F1",
  "theme_color": "#183B50",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "categories": ["government", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Services",
      "short_name": "Services",
      "description": "View verified government schemes and public services",
      "url": "/services",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Post-Matric Scholarship",
      "short_name": "Scholarship",
      "description": "Check eligibility and documents for post-matric scholarship",
      "url": "/services/synthetic-post-matric-scholarship",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
