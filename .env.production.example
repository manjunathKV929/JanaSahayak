# ==============================================================================
# JanaSahayak - Production Environment Configuration Template
# IMPORTANT: In production, inject secrets via Vault / Secret Manager / KMS.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

NODE_ENV=production

# PostgreSQL Database Configuration (Managed PostgreSQL with TLS)
POSTGRES_DB=janasahayak_prod
POSTGRES_USER=janasahayak_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD_FROM_VAULT
POSTGRES_PORT=5432
DATABASE_URL=postgresql://janasahayak_app:REPLACE_WITH_STRONG_GENERATED_PASSWORD_FROM_VAULT@prod-db.internal:5432/janasahayak_prod?sslmode=verify-full
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=25
DATABASE_CONNECTION_TIMEOUT_MS=10000

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=https://janasahayak.gov.in,https://www.janasahayak.gov.in
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=warn
SESSION_SECRET=REPLACE_WITH_MIN_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_FROM_KMS

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_API_URL=https://janasahayak.gov.in/api/v1
NEXT_PUBLIC_APP_URL=https://janasahayak.gov.in
NEXT_PUBLIC_DEFAULT_LOCALE=en

# AI & Language Services (Production Bhashini / Indian AI Gateway)
AI_PROVIDER=bhashini
BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_KEY=REPLACE_WITH_OFFICIAL_BHASHINI_INFERENCE_API_KEY
BHASHINI_USER_ID=REPLACE_WITH_REGISTERED_BHASHINI_USER_ID
